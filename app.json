{
  "expo": {
    "name": "Care",
    "slug": "uhod",
    "scheme": "uhod",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.uhod.care",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.uhod.care",
      "adaptiveIcon": {
        "backgroundColor": "#F3EFE8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Care смотрит фото упаковки, чтобы прочитать название средства.",
          "cameraPermission": "Care использует камеру, чтобы сфотографировать упаковку и прочитать название.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "931fd0c9-389c-43e1-be6c-6eec24ede557"
      }
    },
    "owner": "yanjyli"
  }
}
